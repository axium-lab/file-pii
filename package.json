{
  "name": "@axium-lab/file-pii",
  "version": "0.2.0",
  "description": "Detect personal data (PII) in files with euro-pii and apply a keep/block policy. Also extracts text and metadata. PDF today, no native dependencies.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsup && node scripts/check-dist.mjs",
    "clean": "rm -rf dist",
    "prepare": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "tsx tests/inputs.ts && tsx tests/pii.ts",
    "dev": "tsx watch tests/manual.ts"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:axium-lab/file-pii.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.5.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0"
  },
  "dependencies": {
    "unpdf": "^1.8.1"
  },
  "peerDependencies": {
    "@axium-lab/euro-pii": "*"
  }
}
