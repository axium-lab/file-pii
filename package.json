{
  "name": "@axium-lab/file-extractor",
  "version": "0.1.0",
  "description": "Minimal text extraction from files. PDF first, more formats later.",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsup",
    "prepare": "npm run build",
    "typecheck": "tsc --noEmit",
    "dev": "tsx watch tests/manual.ts"
  },
  "repository": {
    "type": "git",
    "url": "git@ssh.dev.azure.com:v3/axium-lab/pocs/file-extractor"
  },
  "publishConfig": {
    "@axium-lab:registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.5.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0"
  }
}
